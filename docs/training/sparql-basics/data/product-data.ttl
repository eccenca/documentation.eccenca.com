	<http://xmlns.com/foaf/0.1/depiction> <https://api.iconify.design/material-symbols-light/category-outline.svg?color=%23D6AF00&format=svg> .
prod:Service a owl:Class ;
	rdfs:comment "Some value added service realized based on other product(s)."@en ;
